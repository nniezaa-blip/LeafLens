# Lextari environment configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Pass to Flutter:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env

# FastAPI backend origin (use 10.0.2.2 for Android emulator)
API_URL=http://10.0.2.2:8000
WS_URL=ws://10.0.2.2:8000/ws

# Lextari auth Worker (Cloudflare Workers + D1)
# Local: wrangler dev in lextari-api/auth-worker (use 10.0.2.2 for Android emulator)
AUTH_URL=https://lextari-auth.danialsanusi.com
