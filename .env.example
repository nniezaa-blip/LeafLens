# Lextari environment configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Pass to Flutter:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env

# FastAPI backend origin (use 10.0.2.2 for Android emulator)
API_URL=https://lextari-api.danialsanusi.com
WS_URL=wss://lextari-api.danialsanusi.com/ws

# Lextari auth Worker (Cloudflare Workers + D1)
# Local: wrangler dev in lextari-api/auth-worker (use 10.0.2.2 for Android emulator)
AUTH_URL=https://lextari-auth.danialsanusi.com

# Google Sign-In. GOOGLE_SERVER_CLIENT_ID is the *Web application* OAuth client
# from the same Google Cloud project (the Android client alone cannot issue a
# server-verifiable ID token).
GOOGLE_SERVER_CLIENT_ID=895978130173-rcgggovg11jj6d1unudbs2n6iea2sbp7.apps.googleusercontent.com
